# Copy this file to .env.local. Never add real secrets to source control.
GEMINI_API_KEY=
# Change to a model available in your Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The ID of the one permitted Supabase Auth class account. Server-only.
CLASS_ACCOUNT_USER_ID=
# Server-only capability for exchange reservation/saving, never a Supabase admin key.
# Generate/register with scripts/configure-exchange-writer.mjs after migration 004.
SUPABASE_EXCHANGE_WRITE_KEY=
