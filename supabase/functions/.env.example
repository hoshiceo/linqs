# Edge Function secrets only. Never copy these into the Next.js app or Git.
# For local tests, use development credentials and a mocked email provider.
LINQS_EXCHANGE_WRITE_KEY=""
LINQS_CLASS_ACCOUNT_USER_ID=""
LINQS_SUPABASE_PUBLISHABLE_KEY=""
INSTRUCTOR_EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=""
INSTRUCTOR_NOTIFICATION_FROM="Linqs <notifications@example.com>"

# One plain email address set by the administrator; no display names or lists.
# Required only when notifications are enabled. No fallback recipient is used.
INSTRUCTOR_NOTIFICATION_TO=""
