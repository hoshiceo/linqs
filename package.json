{
  "name": "linqs-learning-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "account:create": "node --env-file=.env.setup scripts/create-class-account.mjs",
    "textbooks:extract": "node scripts/extract-textbooks.mjs",
    "textbooks:import": "node --env-file=.env.local --env-file=.env.setup scripts/import-textbooks.mjs",
    "references:build": "node scripts/build-vba-reference-index.mjs",
    "build:checked": "npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "security:audit": "npm audit --audit-level=low",
    "security:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@google/genai": "2.26.0",
    "@supabase/supabase-js": "2.117.2",
    "katex": "0.19.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=22"
  }
}
